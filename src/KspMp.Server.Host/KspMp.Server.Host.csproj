<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AssemblyName>KspMp.Server.Host</AssemblyName>
    <RootNamespace>KspMp.Server.Host</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../KspMp.Server/KspMp.Server.csproj" />
  </ItemGroup>

  <!-- UPnP lives here rather than in KspMp.Server: that library also builds for net472 and ships into
       GameData, where a netstandard dependency would not load. -->
  <ItemGroup>
    <PackageReference Include="Mono.Nat" />
  </ItemGroup>
</Project>
